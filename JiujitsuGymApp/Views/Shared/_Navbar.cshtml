@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
}
@* Shared navbar for every layout, for the same reason _Head is a partial: so
   the two cannot drift apart.

   The user dropdown, the hidden form it posts to, and the handler that wires
   them together all live here rather than in the layout. Splitting them meant
   the auth layout could render the component with nothing listening to it. *@
<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
            <partial name="_BrandMark" />Nexus BJJ
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            @* Left side navigation. Every destination here sits behind the
               global AuthorizeFilter, so offering them to a guest on the
               public landing page would only bounce them to login. The ul
               itself stays either way: flex-grow-1 makes it the spacer that
               pushes the login controls to the right. *@
            <ul class="navbar-nav flex-grow-1">
                @if (isAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Classes" asp-action="Index">
                            <i class="fas fa-calendar-alt me-1"></i>Classes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index">
                            <i class="fas fa-shopping-bag me-1"></i>Products
                        </a>
                    </li>

                    @* Admin link *@
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Index">
                                <i class="fas fa-shield-alt me-1"></i>Admin
                            </a>
                        </li>
                    }
                }
            </ul>

            @* Right side: the signed-in user dropdown. Guests get nothing here -
               the landing page carries its own Get started and Login buttons,
               and the auth pages are the login form, so a second set of
               controls in the navbar is noise. *@
            @if (isAuthenticated)
            {
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <user-nav id="userNav"
                                  is-authenticated="true"
                                  user-name="@($"{User.FindFirst("FirstName")?.Value} {User.FindFirst("LastName")?.Value}".Trim() ?? User.Identity?.Name ?? "Guest")">
                        </user-nav>
                    </li>
                </ul>
            }
        </div>
    </div>
</nav>

@if (isAuthenticated)
{
    @* Hidden form the dropdown posts to. Guests never render the dropdown, so
       giving them one would only mint an antiforgery token nobody can use. *@
    <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display: none;">
        @Html.AntiForgeryToken()
    </form>

    @* type="module" defers on its own, so this runs after the markup above is
       parsed regardless of where the layout drops the partial. *@
    <script type="module">
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('userNav')?.addEventListener('nav-action', (e) => {
                switch (e.detail.action) {
                    case 'profile':
                        window.location.href = '@Url.Action("Index", "Profile")';
                        break;
                    case 'edit-profile':
                        window.location.href = '@Url.Action("Edit", "Profile")';
                        break;
                    case 'change-password':
                        window.location.href = '@Url.Action("ChangePassword", "Profile")';
                        break;
                    case 'logout':
                        document.getElementById('logoutForm')?.submit();
                        break;
                }
            });
        });
    </script>
}
