@*
    Layout for the signed-out pages (login, register).

    What separates this from _Layout is the centred panel, not the chrome: the
    form sits in a fixed-width column against a gradient, where _Layout gives a
    full-width container. Both carry the same navbar and footer.

    The navbar renders as the brand alone for a guest, which is the whole reason
    it can live here now - it offers a way back to the landing page without the
    Classes and Products links that would only bounce a visitor to login.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
</head>

<body class="auth-body">
    <header>
        <partial name="_Navbar" />
    </header>

    <main class="auth-shell" role="main">
        @* Views with more fields than a login form opt into a wider panel. *@
        <div class="auth-panel @(ViewData["AuthPanelWide"] as bool? == true ? "auth-panel-wide" : null)">
            @* The mark is aria-hidden: the wordmark beside it already carries
               the name, so announcing it too would just repeat. *@
            <div class="auth-brand">
                <span class="auth-brand-mark">
                    <partial name="_BrandMark" />
                </span>
                <span class="auth-brand-name">Nexus BJJ</span>
            </div>

            @RenderBody()
        </div>
    </main>

    <footer class="auth-footer border-top text-muted">
        <div class="container py-2 text-center">
            <partial name="_SiteFooter" />
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
