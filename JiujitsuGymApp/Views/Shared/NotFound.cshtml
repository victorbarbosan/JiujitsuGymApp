@{
    ViewData["Title"] = "Page Not Found";
}

<div class="py-5 text-center">
    <i class="fas fa-user-ninja fa-3x text-primary mb-3"></i>
    <h1 class="display-1 fw-bold">404</h1>
    <h2 class="mb-3">This page tapped out</h2>
    <p class="lead text-muted col-md-7 mx-auto">
        The page you're looking for doesn't exist or has been moved.
    </p>
    <div class="d-flex gap-3 justify-content-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="fas fa-home me-2"></i>Back to the mats
        </a>
    </div>
</div>
