@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-sm-5">
        <h1 class="h4 fw-bold mb-1">Choose a new password</h1>
        <p class="text-muted small mb-4">
            Almost there &mdash; pick a new password for <strong>@Model.Email</strong>.
        </p>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <!-- New Password Field -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-lock" aria-hidden="true"></i>
                    </span>
                    <input asp-for="NewPassword" class="form-control" placeholder="Enter a new password"
                           autocomplete="new-password" autofocus />
                    <button class="btn btn-outline-secondary" type="button"
                            id="togglePassword" aria-label="Show password" aria-pressed="false">
                        <i class="fas fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <!-- Confirm Password Field -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-lock" aria-hidden="true"></i>
                    </span>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat the new password"
                           autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-key me-2" aria-hidden="true"></i>Reset password
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const toggle = document.getElementById('togglePassword');
            const password = document.getElementById('@Html.IdFor(m => m.NewPassword)');
            if (!toggle || !password) return;

            toggle.addEventListener('click', () => {
                const shown = password.type === 'text';
                password.type = shown ? 'password' : 'text';
                toggle.setAttribute('aria-pressed', String(!shown));
                toggle.setAttribute('aria-label', shown ? 'Show password' : 'Hide password');
                toggle.querySelector('i').className = shown ? 'fas fa-eye' : 'fas fa-eye-slash';
                password.focus();
            });
        })();
    </script>
}
