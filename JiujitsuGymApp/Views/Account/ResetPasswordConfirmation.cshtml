@{
    ViewData["Title"] = "Password Reset";
    Layout = "_AuthLayout";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-sm-5 text-center">
        <i class="fas fa-circle-check fa-2x text-success mb-3" aria-hidden="true"></i>
        <h1 class="h4 fw-bold mb-2">Password reset</h1>
        <p class="text-muted small mb-4">
            Your password has been changed. Log in with the new one to get back
            on the mats.
        </p>

        <div class="d-grid">
            <a asp-action="Login" class="btn btn-primary btn-lg">
                <i class="fas fa-sign-in-alt me-2" aria-hidden="true"></i>Login
            </a>
        </div>
    </div>
</div>
