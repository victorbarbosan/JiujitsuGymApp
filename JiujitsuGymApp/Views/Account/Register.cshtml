@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
    ViewData["AuthPanelWide"] = true;
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-sm-5">
        <h1 class="h4 fw-bold mb-1">Create your account</h1>
        <p class="text-muted small mb-4">
            Join the gym app to book classes and follow your progress.
        </p>

        <form asp-action="Register" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <!-- Personal Information -->
            <h2 class="h6 text-muted mb-3">Personal Information</h2>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label small fw-semibold"></label>
                    <input asp-for="FirstName" class="form-control" placeholder="First name"
                           autocomplete="given-name" autofocus />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label small fw-semibold"></label>
                    <input asp-for="LastName" class="form-control" placeholder="Last name"
                           autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                    </span>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com"
                           autocomplete="username" autocapitalize="none" spellcheck="false" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Belt" class="form-label small fw-semibold"></label>

                <select asp-for="Belt"
                        class="form-select"
                        asp-items="Model.BeltOptions">
                    <option value="">-- Select Your Belt Rank --</option>
                </select>

                <span asp-validation-for="Belt" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-phone" aria-hidden="true"></i>
                    </span>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number (optional)"
                           autocomplete="tel" />
                </div>
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <!-- Password Section -->
            <h2 class="h6 text-muted mb-3 mt-4">Account Security</h2>
            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-lock" aria-hidden="true"></i>
                    </span>
                    <input asp-for="Password" class="form-control" placeholder="Create a password"
                           autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
                <small class="form-text text-muted">
                    At least 6 characters, with an uppercase letter, a lowercase letter and a digit.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-lock" aria-hidden="true"></i>
                    </span>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your password"
                           autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="fas fa-user-plus me-2" aria-hidden="true"></i>Create Account
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Login Link -->
<p class="text-center text-muted small mt-4 mb-0">
    Already have an account?
    <a asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]">Login here</a>
</p>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
