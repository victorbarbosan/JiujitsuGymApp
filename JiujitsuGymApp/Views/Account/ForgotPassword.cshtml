@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-sm-5">
        <h1 class="h4 fw-bold mb-1">Forgot your password?</h1>
        <p class="text-muted small mb-4">
            Enter your email and we'll send you a link to reset it.
        </p>

        <form asp-action="ForgotPassword" method="post" id="forgotPasswordForm">
            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <!-- Email Field -->
            <div class="mb-4">
                <label asp-for="Email" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                    </span>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com"
                           autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg" id="submitButton">
                    <span class="spinner-border spinner-border-sm me-2 d-none" data-spinner
                          role="status" aria-hidden="true"></span>
                    <i class="fas fa-paper-plane me-2" data-icon aria-hidden="true"></i><span data-label>Email reset link</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Links -->
<p class="text-center text-muted small mt-4 mb-0">
    Remembered it after all?
    <a asp-action="Login">Back to login</a>
</p>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const form = document.getElementById('forgotPasswordForm');
            const button = document.getElementById('submitButton');
            if (!form || !button) return;

            const spinner = button.querySelector('[data-spinner]');
            const icon = button.querySelector('[data-icon]');
            const label = button.querySelector('[data-label]');

            function setBusy(busy) {
                button.disabled = busy;
                spinner.classList.toggle('d-none', !busy);
                icon.classList.toggle('d-none', busy);
                label.textContent = busy ? 'Sending…' : 'Email reset link';
            }

            form.addEventListener('submit', function () {
                // Ask jQuery rather than checkValidity(): the tag helpers emit
                // data-val attributes, not the HTML5 required attribute, so the
                // native check passes on an empty field and would leave the
                // button stuck spinning on a submit validation is about to block.
                const validator = window.jQuery && window.jQuery.fn.valid;
                if (validator && !window.jQuery(form).valid()) return;

                setBusy(true);
            });

            // Returning with the back button restores the disabled button from
            // the bfcache, which would leave the form unusable.
            window.addEventListener('pageshow', function () { setBusy(false); });
        })();
    </script>
}
