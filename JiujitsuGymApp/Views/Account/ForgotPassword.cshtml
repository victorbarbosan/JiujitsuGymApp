@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-sm-5">
        <h1 class="h4 fw-bold mb-1">Forgot your password?</h1>
        <p class="text-muted small mb-4">
            Enter your email and we'll send you a link to reset it.
        </p>

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <!-- Email Field -->
            <div class="mb-4">
                <label asp-for="Email" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                    </span>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com"
                           autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-paper-plane me-2" aria-hidden="true"></i>Email reset link
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Links -->
<p class="text-center text-muted small mt-4 mb-0">
    Remembered it after all?
    <a asp-action="Login">Back to login</a>
</p>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
