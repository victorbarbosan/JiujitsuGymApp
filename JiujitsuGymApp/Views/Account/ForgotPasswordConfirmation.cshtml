@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_AuthLayout";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-sm-5 text-center">
        <i class="fas fa-envelope-open-text fa-2x text-primary mb-3" aria-hidden="true"></i>
        <h1 class="h4 fw-bold mb-2">Check your email</h1>
        <p class="text-muted small mb-0">
            If an account exists for that address, a password reset link is on its
            way. The link expires in 24 hours &mdash; check your spam folder if it
            doesn't show up in a few minutes.
        </p>
    </div>
</div>

<!-- Links -->
<p class="text-center text-muted small mt-4 mb-0">
    <a asp-action="Login">Back to login</a>
</p>
