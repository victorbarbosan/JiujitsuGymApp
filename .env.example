# Copy to `.env` (gitignored) and fill in. This file is read by DOCKER COMPOSE
# ONLY - it configures the containers, not the app when you run it from Visual
# Studio or `dotnet run`. See "Running the app directly" below for that case.

# Password for the bundled Postgres container. Also used to build the app
# container's connection string.
POSTGRES_PASSWORD=postgres

# Bootstrap administrator for the containerised app, created on startup when no
# account holds this address yet. Only takes effect under `docker compose up`.
#
# Must satisfy the Identity rules in Program.cs: at least 6 characters, with an
# uppercase letter, a lowercase letter and a digit.
SEED_ADMIN_EMAIL=admin@nexusbjj.local
SEED_ADMIN_PASSWORD=

# Gmail SMTP relay for the forgot-password email. SMTP_USERNAME is the Gmail
# address; SMTP_PASSWORD is an *app password* created at
# https://myaccount.google.com/apppasswords (requires 2FA on the account),
# NOT the normal account password. Leave both empty to run without email -
# everything works except the reset email, whose failure is only logged.
SMTP_USERNAME=
SMTP_PASSWORD=

# Google external login. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with authorized redirect
# URI <your-domain>/signin-google. Leave both empty to run without it - the
# provider is simply not registered and the Google sign-in button is unusable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Running the app directly (Visual Studio F5, `dotnet run`)
# ---------------------------------------------------------------------------
# .NET does not read .env files - that is a compose convention. Use user-secrets
# instead, which keeps the values outside the repository entirely:
#
#   dotnet user-secrets --project JiujitsuGymApp set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5432;Database=jiujitsugym;Username=postgres;Password=postgres"
#   dotnet user-secrets --project JiujitsuGymApp set "SeedAdmin:Email" "admin@nexusbjj.local"
#   dotnet user-secrets --project JiujitsuGymApp set "SeedAdmin:Password" "<your password>"
#   dotnet user-secrets --project JiujitsuGymApp set "Smtp:Username" "you@gmail.com"
#   dotnet user-secrets --project JiujitsuGymApp set "Smtp:Password" "<gmail app password>"
#   dotnet user-secrets --project JiujitsuGymApp set "Authentication:Google:ClientId" "<google client id>"
#   dotnet user-secrets --project JiujitsuGymApp set "Authentication:Google:ClientSecret" "<google client secret>"
#
# In Visual Studio: right-click the project > Manage User Secrets.
#
# appsettings.json ships an empty DefaultConnection on purpose - it is committed,
# and a connection string carries a password. The app fails at startup with
# these instructions rather than falling back to a default.
#
# User secrets load only in the Development environment, which is what the
# launch profiles set. Real environment variables still win over them, so
# production is unaffected.
#
# ---------------------------------------------------------------------------
# Production (Raspberry Pi)
# ---------------------------------------------------------------------------
# Neither of the above applies. The Pi deploys from the private infra repo's own
# compose file, so set SeedAdmin__Email, SeedAdmin__Password, Smtp__Username,
# Smtp__Password, Authentication__Google__ClientId and
# Authentication__Google__ClientSecret there.
